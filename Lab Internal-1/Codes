const apiKey = "YOUR_API_KEY";

// Arrow Function
const fetchWeatherData = (city) => {
    return fetch(
        `https://api.openweathermap.org/data/2.5/forecast?q=${city}&appid=${apiKey}&units=metric`
    )
    .then(response => response.json());   // Promise
};

// Callback Example
const processWeatherData = (data, callback) => {
    const temperatures = data.list.slice(0, 8).map(item => item.main.temp);
    const times = data.list.slice(0, 8).map(item => item.dt_txt);

    callback(times, temperatures);
};

// Async/Await Example
const getWeather = async () => {
    const city = document.getElementById("city").value;

    try {
        const data = await fetchWeatherData(city);  // Await Promise
        processWeatherData(data, displayGraph);     // Callback

    } catch (error) {
        alert("Error fetching weather data");
    }
};

// Display Graph Function
const displayGraph = (labels, temps) => {

    const ctx = document.getElementById("weatherChart").getContext("2d");

    new Chart(ctx, {
        type: "line",
        data: {
            labels: labels,
            datasets: [{
                label: "Temperature (°C)",
                data: temps,
                borderColor: "blue",
                backgroundColor: "lightblue",
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true
                }
            }
        }
    });
};



